{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/scripts/quotemem-hook.sh\" UserPromptSubmit", "timeout": 15 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/scripts/quotemem-hook.sh\" Stop", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/scripts/quotemem-hook.sh\" SessionEnd", "timeout": 5 }] }
    ]
  }
}
